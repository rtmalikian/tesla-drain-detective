# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored — your secrets never leave your machine.

# --- Tesla Fleet API credentials ---------------------------------------
# Register a developer application at https://developer.tesla.com
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
# Fleet API region: na (North America), eu (Europe), cn (China)
TESLA_REGION=na
TESLA_REDIRECT_URI=http://localhost:8080/callback
# Where OAuth tokens are stored locally (file is created with mode 600)
TESLA_TOKEN_FILE=~/.tcc/tokens.json

# --- Your vehicles -------------------------------------------------------
# Format: name=VIN, one entry per car, comma-separated.
TCC_VEHICLES=Daily=5YJ3E1EA0KF000001,Second=7SAYGDEE5PF000002

# --- Drain detection -----------------------------------------------------
# Alert when overnight drain exceeds this rate (% of battery per hour).
# A quiet parked Tesla loses ~0.05-0.2%/h; Sentry Mode alone is ~0.7%/h.
TCC_DRAIN_ALERT_PCT_PER_H=0.5
# Night window: baseline SoC is recorded after NIGHT_START, evaluated at NIGHT_END.
TCC_NIGHT_START=22:00
TCC_NIGHT_END=07:00
# How long after NIGHT_END to keep retrying if the car is asleep (hours).
TCC_MORNING_GRACE_HOURS=4

# --- Alerts (ntfy.sh — free, no account) ----------------------------------
# Pick a secret, unguessable topic, e.g. output of: openssl rand -hex 12
# Subscribe on your phone with the ntfy app to get push alerts.
TCC_NTFY_TOPIC=

# --- Runtime ---------------------------------------------------------------
TCC_STATE_FILE=~/.tcc/drain_detective_state.json
# How often the loop checks whether a checkpoint is due (seconds).
# The app only calls the API at the two nightly checkpoints — never polls.
TCC_POLL_INTERVAL_SECONDS=600
# Dry run: log what WOULD happen without sending any alerts.
TCC_DRY_RUN=false
